# Frontend Environment Variables for Production/Docker
# This file is used by Vue CLI when building for production (npm run build)

# In Docker/production, both frontend and backend are on the same host
# The frontend is served via nginx on port 3000 (mapped from 80)
# The backend is on port 6500
# Since they're accessed via the same hostname, we use relative path
VUE_APP_BASE_URL=http://localhost:6500

# Note: In actual production deployment, you would set this to your actual domain
# Example: VUE_APP_BASE_URL=https://api.yourdomain.com
